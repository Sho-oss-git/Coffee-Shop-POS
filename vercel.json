{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "public/index.php": {
      "runtime": "@vercel/php@0.7.0"
    }
  },
  "routes": [
    { "src": "^/build/(.*)$", "dest": "public/build/$1" },
    { "src": "^/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot|map|webp|avif))$", "dest": "public/$1" },
    { "src": "/(.*)", "dest": "public/index.php" }
  ]
}
